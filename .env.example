# -------------------------------------------------------------
# Intelli-CA Environment Configuration
# -------------------------------------------------------------

# Google Gemini API Key
# Required on the backend/server for Tax intelligence RAG, financial extraction, and audit reasoning.
GEMINI_API_KEY=

# Frontend API Base URL
# - Default: '/api/v1' (for unified full-stack Render deployment or local development)
# - For split deployment: set to your Render backend URL (e.g. 'https://your-service.onrender.com/api/v1')
VITE_API_BASE_URL=/api/v1

# Backend Port
# Render assigns this dynamically (e.g. 10000). Defaults to 3000 locally.
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production
